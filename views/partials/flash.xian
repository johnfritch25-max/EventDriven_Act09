{{#if success_msg}}
  <div class="max-w-7xl mx-auto px-4 mt-3">
    <div class="bg-green-100 border border-green-400 text-green-800 px-4 py-2 rounded flex justify-between items-center">
      <span>✅ {{success_msg}}</span>
    </div>
  </div>
{{/if}}
{{#if error_msg}}
  <div class="max-w-7xl mx-auto px-4 mt-3">
    <div class="bg-red-100 border border-red-400 text-red-800 px-4 py-2 rounded flex justify-between items-center">
      <span>❌ {{error_msg}}</span>
    </div>
  </div>
{{/if}}
