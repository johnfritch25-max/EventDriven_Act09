{{> head}}
<body class="bg-gray-50">

  <nav class="bg-gray-800 text-white px-6 py-3 flex items-center justify-between">
    <span class="font-bold">🛠️ Admin Panel</span>
    <div class="flex gap-4 text-sm">
      <a href="/admin" class="hover:text-yellow-300">Dashboard</a>
      <a href="/admin/products" class="hover:text-yellow-300">Products</a>
      <a href="/admin/orders" class="hover:text-yellow-300">Orders</a>
      <a href="/admin/users" class="hover:text-yellow-300">Users</a>
      <a href="/shop" class="hover:text-yellow-300">View Shop</a>
      <a href="/logout" class="text-red-400 hover:underline">Logout</a>
    </div>
  </nav>

  {{#if success_msg}}
    <div class="bg-green-100 text-green-700 px-6 py-2 text-sm">✅ {{success_msg}}</div>
  {{/if}}

  <div class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6 text-gray-800">Orders</h1>

    {{#if orders.length}}
      {{#each orders}}
        <div class="bg-white border rounded p-4 mb-4">
          <div class="flex flex-wrap justify-between items-start gap-2 mb-3">
            <div>
              <span class="font-semibold text-gray-700">Order #{{id}}</span>
              <span class="text-xs text-gray-400 ml-2">{{createdAt}}</span>
              {{#if User}}
                <span class="text-xs text-gray-500 ml-2">· {{User.name}} ({{User.email}})</span>
              {{/if}}
            </div>
            <!-- Status update form -->
            <form method="POST" action="/admin/orders/status/{{id}}" class="flex gap-2 items-center">
              <select name="status" class="border rounded px-2 py-1 text-sm">
                <option value="pending" {{#if (eq status 'pending')}}selected{{/if}}>Pending</option>
                <option value="processing" {{#if (eq status 'processing')}}selected{{/if}}>Processing</option>
                <option value="shipped" {{#if (eq status 'shipped')}}selected{{/if}}>Shipped</option>
                <option value="delivered" {{#if (eq status 'delivered')}}selected{{/if}}>Delivered</option>
                <option value="cancelled" {{#if (eq status 'cancelled')}}selected{{/if}}>Cancelled</option>
              </select>
              <button type="submit" class="bg-gray-700 hover:bg-gray-800 text-white px-3 py-1 rounded text-xs">Update</button>
            </form>
          </div>

          {{#each items}}
            <div class="flex justify-between text-sm py-1 border-b last:border-0">
              <span>{{productName}} × {{quantity}}</span>
              <span>₱{{price}}</span>
            </div>
          {{/each}}
          <div class="flex justify-between font-semibold mt-2 text-blue-600">
            <span>Total</span>
            <span>₱{{total}}</span>
          </div>
          {{#if address}}
            <p class="text-xs text-gray-400 mt-1">Address: {{address}}</p>
          {{/if}}
        </div>
      {{/each}}
    {{else}}
      <div class="text-center py-16 text-gray-400">
        <p>No orders yet.</p>
      </div>
    {{/if}}
  </div>

{{> footer}}
