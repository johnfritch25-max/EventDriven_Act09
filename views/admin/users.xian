{{> head}}
<body class="bg-gray-50">

  <nav class="bg-gray-800 text-white px-6 py-3 flex items-center justify-between">
    <span class="font-bold">🛠️ Admin Panel</span>
    <div class="flex gap-4 text-sm">
      <a href="/admin" class="hover:text-yellow-300">Dashboard</a>
      <a href="/admin/products" class="hover:text-yellow-300">Products</a>
      <a href="/admin/orders" class="hover:text-yellow-300">Orders</a>
      <a href="/admin/users" class="hover:text-yellow-300">Users</a>
      <a href="/shop" class="hover:text-yellow-300">View Shop</a>
      <a href="/logout" class="text-red-400 hover:underline">Logout</a>
    </div>
  </nav>

  {{#if success_msg}}
    <div class="bg-green-100 text-green-700 px-6 py-2 text-sm">✅ {{success_msg}}</div>
  {{/if}}

  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6 text-gray-800">Users</h1>

    <div class="bg-white border rounded overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-100 text-gray-600">
          <tr>
            <th class="text-left px-4 py-2">Name</th>
            <th class="text-left px-4 py-2">Email</th>
            <th class="text-left px-4 py-2">Role</th>
            <th class="px-4 py-2">Change Role</th>
          </tr>
        </thead>
        <tbody>
          {{#each users}}
            <tr class="border-t hover:bg-gray-50">
              <td class="px-4 py-2 font-medium">{{name}}</td>
              <td class="px-4 py-2 text-gray-500">{{email}}</td>
              <td class="px-4 py-2">
                <span class="text-xs px-2 py-0.5 rounded
                  {{#if (eq role 'admin')}}bg-yellow-100 text-yellow-700{{/if}}
                  {{#if (eq role 'staff')}}bg-blue-100 text-blue-700{{/if}}
                  {{#if (eq role 'visitors')}}bg-gray-100 text-gray-600{{/if}}
                ">{{role}}</span>
              </td>
              <td class="px-4 py-2 text-center">
                <form method="POST" action="/admin/users/role/{{id}}" class="flex gap-2 justify-center">
                  <select name="role" class="border rounded px-2 py-1 text-xs">
                    <option value="visitors" {{#if (eq role 'visitors')}}selected{{/if}}>visitors</option>
                    <option value="staff" {{#if (eq role 'staff')}}selected{{/if}}>staff</option>
                    <option value="admin" {{#if (eq role 'admin')}}selected{{/if}}>admin</option>
                  </select>
                  <button type="submit" class="bg-gray-700 hover:bg-gray-800 text-white px-2 py-1 rounded text-xs">Save</button>
                </form>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

{{> footer}}
