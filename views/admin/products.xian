{{> head}}
<body class="bg-gray-50">

  <nav class="bg-gray-800 text-white px-6 py-3 flex items-center justify-between">
    <span class="font-bold">🛠️ Admin Panel</span>
    <div class="flex gap-4 text-sm">
      <a href="/admin" class="hover:text-yellow-300">Dashboard</a>
      <a href="/admin/products" class="hover:text-yellow-300">Products</a>
      <a href="/admin/orders" class="hover:text-yellow-300">Orders</a>
      <a href="/admin/users" class="hover:text-yellow-300">Users</a>
      <a href="/shop" class="hover:text-yellow-300">View Shop</a>
      <a href="/logout" class="text-red-400 hover:underline">Logout</a>
    </div>
  </nav>

  {{#if success_msg}}
    <div class="bg-green-100 text-green-700 px-6 py-2 text-sm">✅ {{success_msg}}</div>
  {{/if}}
  {{#if error_msg}}
    <div class="bg-red-100 text-red-700 px-6 py-2 text-sm">❌ {{error_msg}}</div>
  {{/if}}

  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Products</h1>
      <a href="/admin/products/add" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded text-sm">+ Add Product</a>
    </div>

    {{#if products.length}}
      <div class="bg-white border rounded overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-gray-100 text-gray-600">
            <tr>
              <th class="text-left px-4 py-2">Image</th>
              <th class="text-left px-4 py-2">Name</th>
              <th class="text-left px-4 py-2">Category</th>
              <th class="text-left px-4 py-2">Price</th>
              <th class="text-left px-4 py-2">Stock</th>
              <th class="px-4 py-2">Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each products}}
              <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-2">
                  {{#if image}}
                    <img src="{{image}}" class="w-12 h-12 object-cover rounded" />
                  {{else}}
                    <div class="w-12 h-12 bg-gray-100 rounded flex items-center justify-center text-xl">📦</div>
                  {{/if}}
                </td>
                <td class="px-4 py-2 font-medium">{{name}}</td>
                <td class="px-4 py-2 text-gray-500">{{category}}</td>
                <td class="px-4 py-2 text-blue-600 font-semibold">₱{{price}}</td>
                <td class="px-4 py-2">{{stock}}</td>
                <td class="px-4 py-2 text-center flex gap-2 justify-center">
                  <a href="/admin/products/edit/{{id}}" class="text-blue-500 hover:underline text-xs">Edit</a>
                  <form method="POST" action="/admin/products/delete/{{id}}" onsubmit="return confirm('Delete this product?')">
                    <button type="submit" class="text-red-500 hover:underline text-xs">Delete</button>
                  </form>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="text-center py-16 text-gray-400">
        <p>No products yet. <a href="/admin/products/add" class="text-blue-500 hover:underline">Add one</a>.</p>
      </div>
    {{/if}}
  </div>

{{> footer}}
