<nav class="bg-indigo-700 text-white shadow-md">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/shop" class="text-xl font-bold tracking-tight">🛍️ ShopXian</a>
    <div class="flex items-center gap-4 text-sm font-medium">
      <a href="/shop" class="hover:text-indigo-200 transition">Shop</a>
      <a href="/cart" class="hover:text-indigo-200 transition">🛒 Cart</a>
      {{#if user}}
        <a href="/orders" class="hover:text-indigo-200 transition">My Orders</a>
        {{#if (eq role "admin")}}
          <a href="/admin" class="bg-yellow-400 text-gray-900 px-3 py-1 rounded hover:bg-yellow-300 transition">Admin</a>
        {{/if}}
        <a href="/logout" class="bg-red-500 px-3 py-1 rounded hover:bg-red-400 transition">Logout</a>
        <span class="text-indigo-200">Hi, {{user}}</span>
      {{else}}
        <a href="/login" class="hover:text-indigo-200 transition">Login</a>
        <a href="/register" class="bg-white text-indigo-700 px-3 py-1 rounded hover:bg-indigo-100 transition">Register</a>
      {{/if}}
    </div>
  </div>
</nav>
